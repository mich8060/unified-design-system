{
  "name": "@chghealthcare/unified-design-system",
  "version": "1.0.7",
  "packageManager": "npm@10.9.2",
  "description": "React UI primitives and styles built with Tailwind CSS v4 and shadcn-style components (UDS).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chghealthcare/unified-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/chghealthcare/unified-design-system/issues"
  },
  "homepage": "https://github.com/chghealthcare/unified-design-system#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "AI_USAGE.md",
    "AGENTS.md",
    "setup.md",
    "figma.component.rules.md",
    "LICENSE",
    "design-language",
    "ai/uds-contract.json",
    "ai/figma-component-manifest.json",
    "ai/figma-component-props.json",
    "ai/recipes",
    "ai/examples",
    "ai/guides",
    "ai/appshell.schema.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/base.css": "./dist/styles-base.css",
    "./fonts/Inter-Variable.woff2": "./dist/fonts/Inter-Variable.woff2",
    "./chart": {
      "types": "./dist/components/ui/chart.d.ts",
      "import": "./dist/components/ui/chart.js",
      "require": "./dist/components/ui/chart.cjs"
    },
    "./menu": {
      "types": "./dist/components/ui/menu.d.ts",
      "import": "./dist/components/ui/menu.js",
      "require": "./dist/components/ui/menu.cjs"
    },
    "./calendar": {
      "types": "./dist/components/ui/calendar.d.ts",
      "import": "./dist/components/ui/calendar.js",
      "require": "./dist/components/ui/calendar.cjs"
    },
    "./micro-calendar": {
      "types": "./dist/components/ui/micro-calendar.d.ts",
      "import": "./dist/components/ui/micro-calendar.js",
      "require": "./dist/components/ui/micro-calendar.cjs"
    },
    "./date-input": {
      "types": "./dist/components/ui/date-input.d.ts",
      "import": "./dist/components/ui/date-input.js",
      "require": "./dist/components/ui/date-input.cjs"
    },
    "./date-range-input": {
      "types": "./dist/components/ui/date-range-input.d.ts",
      "import": "./dist/components/ui/date-range-input.js",
      "require": "./dist/components/ui/date-range-input.cjs"
    },
    "./command": {
      "types": "./dist/components/ui/command.d.ts",
      "import": "./dist/components/ui/command.js",
      "require": "./dist/components/ui/command.cjs"
    },
    "./drawer": {
      "types": "./dist/components/ui/drawer.d.ts",
      "import": "./dist/components/ui/drawer.js",
      "require": "./dist/components/ui/drawer.cjs"
    },
    "./resizable": {
      "types": "./dist/components/ui/resizable.d.ts",
      "import": "./dist/components/ui/resizable.js",
      "require": "./dist/components/ui/resizable.cjs"
    },
    "./sonner": {
      "types": "./dist/components/ui/sonner.d.ts",
      "import": "./dist/components/ui/sonner.js",
      "require": "./dist/components/ui/sonner.cjs"
    },
    "./input-otp": {
      "types": "./dist/components/ui/input-otp.d.ts",
      "import": "./dist/components/ui/input-otp.js",
      "require": "./dist/components/ui/input-otp.cjs"
    },
    "./package.json": "./package.json",
    "./contract": "./ai/uds-contract.json",
    "./figma-component-manifest": "./ai/figma-component-manifest.json",
    "./figma-component-props": "./ai/figma-component-props.json",
    "./figma-rules": "./figma.component.rules.md",
    "./design-language": "./design-language",
    "./setup": "./setup.md"
  },
  "volta": {
    "node": "22.22.2"
  },
  "keywords": [
    "react",
    "tailwind",
    "tailwindcss",
    "design-system",
    "components",
    "ui",
    "shadcn"
  ],
  "scripts": {
    "generate:ai": "node ./scripts/generate-ai-artifacts.mjs",
    "dev": "vite --config vite.config.docs.ts",
    "build": "npm run build:lib && npm run build:docs",
    "prepublishOnly": "npm run build:lib",
    "build:lib": "vite build --config vite.config.lib.ts && vite build --config vite.config.lib-base-css.ts && tsc -p tsconfig.lib.json && node ./scripts/prepare-package.mjs",
    "build:docs": "node ./scripts/sync-docs-version-snapshot.mjs && vite build --config vite.config.docs.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "pack:check": "npm_config_cache=/tmp/uds-tailwind-test-npm-cache npm pack --dry-run",
    "preview": "vite preview --config vite.config.docs.ts",
    "ci:bundle": "node ./scripts/ci-bundle.mjs",
    "test:consumer-fixture": "node ./scripts/test-consumer-fixture.mjs",
    "test:docs-versions": "node --test ./scripts/lib/docs-version-policy.test.mjs && node ./scripts/docs-versions-smoke.mjs",
    "validate:uds": "node ./scripts/validate-uds-compliance.mjs",
    "validate:figma": "node ./scripts/validate-figma-artifacts.mjs",
    "validate:ai": "node ./scripts/validate-uds-compliance.mjs && node ./scripts/validate-figma-artifacts.mjs",
    "test": "node --test ./scripts/lib/docs-version-policy.test.mjs ./scripts/lib/figma-variable-scopes.test.mjs ./scripts/lib/figma-artifacts-drift.test.mjs",
    "generate:storybook": "node ./scripts/generate-storybook-stories.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run generate:storybook && storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.4.6",
    "globals": "^17.4.0",
    "playwright": "^1.61.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "sass": "^1.99.0",
    "shadcn": "^4.2.0",
    "shiki": "^4.3.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.10"
  }
}
